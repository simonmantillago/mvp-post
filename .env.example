# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Web Push: clave pública VAPID (npx web-push generate-vapid-keys). La privada va solo en los secretos de Supabase.
VITE_VAPID_PUBLIC_KEY=
# Opcional: pósters en Cartelera (themoviedb.org → API)
VITE_TMDB_API_KEY=
# Correos de las dos credenciales del login (cuentas creadas a mano en Supabase)
VITE_EMAIL_HER=
VITE_EMAIL_HIM=
